# Moodle UFSC - copie para .env e preencha
MOODLE_URL=https://presencial.moodle.ufsc.br
# Moodle -> Preferencias -> Chaves de seguranca (servico: moodle_mobile_app)
MOODLE_TOKEN=
# auto = deduz da data (jan-jul -> N1, ago-dez -> N2); ou fixe: 20262
SEMESTRE=auto
CACHE_DIR=./cache
DB_PATH=./dados.db
CATALOGO_URL=https://programas-planos.inf.ufsc.br
